// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// Sin roles/permisos: solo el dueño del negocio y el desarrollador acceden
// al panel, y ambos necesitan acceso completo. Existió un enum Role
// (ADMIN/OPERATOR) que nunca se usaba para restringir nada — se sacó en vez
// de dejar RBAC a medio implementar sin necesidad comercial real.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  imageUrl  String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([isActive])
  @@map("categories")
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  imageUrl  String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([isActive])
  @@map("brands")
}

model Product {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  description      String?
  price            Decimal        @db.Decimal(10, 2)
  stock            Int            @default(0)
  sku              String?        @unique
  isActive         Boolean        @default(true)
  isLimitedEdition Boolean        @default(false)
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id])
  brandId          String?
  brand            Brand?         @relation(fields: [brandId], references: [id])
  images           ProductImage[]
  reviews          Review[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
  @@index([isLimitedEdition])
  @@map("products")
}

// Fila única (id fijo "singleton") con el cartel flotante configurable
// desde el admin — no hay historial ni múltiples anuncios simultáneos.
model Announcement {
  id          String    @id @default(cuid())
  isActive    Boolean   @default(false)
  startAt     DateTime?
  endAt       DateTime?
  title       String
  description String?
  buttonText  String?
  url         String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("announcements")
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  publicId     String
  url          String
  alt          String?
  position     Int      @default(0)
  // Segunda imagen que se muestra al hacer hover sobre la card del catálogo
  // (ver ProductCard). Independiente de `position`/la galería completa: como
  // mucho una imagen por producto tiene esto en true, se aplica a nivel app
  // en setHoverProductImage (unset-all + set), no hay constraint de DB —
  // mismo criterio ya usado para "principal" (posición 0).
  isHoverImage Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([productId, position])
  @@map("product_images")
}

// Reseña pública de un visitante (sin cuenta de cliente, así que se guarda
// el nombre tal cual lo escribió). productId es opcional: null = reseña
// general de la tienda, no ligada a un producto puntual. Nace en PENDING y
// solo se muestra en el sitio público una vez aprobada desde el admin.
model Review {
  id         String       @id @default(cuid())
  productId  String?
  product    Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  authorName String
  rating     Int
  comment    String?
  status     ReviewStatus @default(PENDING)
  adminReply String?
  repliedAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status])
  @@index([productId])
  @@map("reviews")
}

// Frases de la barra promocional debajo del navbar (ver
// AnnouncementMarquee) — antes hardcodeadas en el componente. `position`
// define el orden de aparición; `isActive` permite ocultar una frase sin
// borrarla.
model MarqueeItem {
  id        String   @id @default(cuid())
  text      String
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
  @@map("marquee_items")
}

// Franja de beneficios de la Home (BenefitsStrip) y su versión compacta en
// el detalle de producto (ProductTrustStrip) — antes hardcodeada en
// benefits-strip.tsx. `icon` es una clave del registro cerrado de
// src/lib/benefit-icons.ts (no un nombre libre de lucide), así el admin
// elige de una lista y el bundle no carga todos los íconos.
model Benefit {
  id        String   @id @default(cuid())
  icon      String
  title     String
  text      String
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
  @@map("benefits")
}

// Soporte para el rate limiting de login y alta de reseñas (ver
// src/lib/rate-limit.ts). Un Map en memoria no sirve en Vercel: cada
// instancia serverless tiene su propio proceso, así que bajo tráfico
// concurrente cada una llevaría su propio contador, y cada deploy/reciclado
// de instancia lo reiniciaría a cero.
//
// Un contador por key (no una fila por intento, como en el diseño
// anterior): permite hacer el incremento + reset-si-venció con un único
// UPSERT atómico en Postgres (INSERT ... ON CONFLICT DO UPDATE), sin
// condición de carrera entre leer y escribir. Ver checkRateLimit().
model RateLimitBucket {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime

  @@map("rate_limit_buckets")
}
